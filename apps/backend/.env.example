PORT=3000
DATABASE_URL=file:./portal.db
JWT_SECRET=replace-with-at-least-32-random-characters
WEB_ORIGIN=http://localhost:3000
UPLOAD_DIR=./uploads
# Production object storage. Leave S3_BUCKET empty for local filesystem uploads.
AWS_REGION=ap-south-1
S3_BUCKET=
S3_PREFIX=safar-media
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# Generate 32 random bytes encoded as 64 hexadecimal characters.
DOCUMENT_ENCRYPTION_KEY=
# Optional separate AES-256-GCM key for bank account numbers. Falls back to DOCUMENT_ENCRYPTION_KEY.
PAYOUT_ENCRYPTION_KEY=
SANDBOX_ENV=test
SANDBOX_API_KEY=
SANDBOX_API_SECRET=
# Must be registered with Sandbox for your account.
KYC_REDIRECT_URL=http://localhost:3000/kyc.html
BUSINESS_NAME=Safar Self Drive
BUSINESS_LEGAL_NAME=Safar Self Drive
BUSINESS_ADDRESS=
BUSINESS_EMAIL=
BUSINESS_PHONE=
# Razorpay checkout. Keep the secret only on the backend; configure the
# webhook URL as https://your-domain.example/api/payments/webhook.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=
# Background reconciliation for expired payment holds and expired vehicle docs.
ENABLE_OPERATIONS_JOBS=true
OPERATIONS_JOB_INTERVAL_MS=300000
# The API populates the supplied agreement template with python-docx. LibreOffice is optional;
# when unavailable, the bundled ReportLab fallback still creates a booking PDF.
AGREEMENT_PYTHON=python
AGREEMENT_SOFFICE=soffice
# Alternatively set AGREEMENT_DOCX_RENDERER to the repository's render_docx.py helper.
