PORT=3000
DATABASE_URL=file:./portal.db
JWT_SECRET=replace-with-at-least-32-random-characters
WEB_ORIGIN=http://localhost:3000
# OTP_PROVIDER=local keeps the development OTP flow. Use msg91 in staging/production.
OTP_PROVIDER=local
MSG91_AUTHKEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_OTP_SEND_URL=https://control.msg91.com/api/v5/otp
MSG91_OTP_VERIFY_URL=https://control.msg91.com/api/v5/otp/verify
MSG91_OTP_RETRY_URL=https://control.msg91.com/api/v5/otp/retry
# Uploaded photos and documents are stored in a private S3 bucket only (never on the server's disk) and are always
# served through /api/media, which checks access first. Production refuses to start without S3_BUCKET.
# On AWS, leave S3_ENDPOINT/S3_FORCE_PATH_STYLE empty and prefer an instance role over access keys.
# For local development point S3_ENDPOINT at an S3 emulator (see docs/MEDIA_STORAGE.md).
S3_BUCKET=
S3_REGION=ap-south-1
# Servers that already stored files under the earlier "safar-media" folder should set S3_PREFIX=safar-media.
S3_PREFIX=media/
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional, AWS only: AES256 or aws:kms. Private documents are additionally encrypted by the app.
S3_SERVER_SIDE_ENCRYPTION=
# Generate 32 random bytes encoded as 64 hexadecimal characters.
DOCUMENT_ENCRYPTION_KEY=
# Optional separate AES-256-GCM key for bank account numbers. Falls back to DOCUMENT_ENCRYPTION_KEY.
PAYOUT_ENCRYPTION_KEY=
SANDBOX_ENV=test
SANDBOX_API_KEY=
SANDBOX_API_SECRET=
# Must be registered with Sandbox for your account.
KYC_REDIRECT_URL=http://localhost:3000/kyc.html
BUSINESS_NAME=Safar Self Drive
BUSINESS_LEGAL_NAME=Safar Self Drive
BUSINESS_ADDRESS=
BUSINESS_EMAIL=
BUSINESS_PHONE=
# Razorpay checkout. Keep the secret only on the backend; configure the
# webhook URL as https://your-domain.example/api/payments/webhook.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=
# Background reconciliation for expired payment holds and expired vehicle docs.
ENABLE_OPERATIONS_JOBS=true
OPERATIONS_JOB_INTERVAL_MS=300000
# The API populates the supplied agreement template with python-docx. LibreOffice is optional;
# when unavailable, the bundled ReportLab fallback still creates a booking PDF.
AGREEMENT_PYTHON=python
AGREEMENT_SOFFICE=soffice
# Alternatively set AGREEMENT_DOCX_RENDERER to the repository's render_docx.py helper.
# Kill an agreement converter (python/soffice) that runs longer than this. Default 60000.
AGREEMENT_PROCESS_TIMEOUT_MS=60000
# How often unpaid checkout holds past their 30-minute window are released (CANCELLED + HOLD_EXPIRED audit).
# Default 60000; 0 disables the in-process sweep. Safe to run on several instances at once.
HOLD_EXPIRY_INTERVAL_MS=60000
# Leave empty for direct connections. Behind nginx on the same host use "loopback"; behind a load balancer use
# its subnet(s) or a hop count. Avoid "true", which lets clients spoof X-Forwarded-For.
TRUST_PROXY=
# Local demos only: "true" lets the labelled DEMO_SEED records count as verification (see docs/DEMO_MODE.md).
# The API refuses to start with it in production. Leave empty everywhere else.
DEMO_VERIFICATION=
