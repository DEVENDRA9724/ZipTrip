datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  HOST
  DEALER
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum VehicleStatus {
  PENDING_APPROVAL
  ACTIVE
  INACTIVE
  MAINTENANCE
}

model User {
  id              String    @id @default(uuid())
  username        String?   @unique
  email           String    @unique
  phone           String?   @unique
  phoneVerifiedAt DateTime?
  otpCodeHash     String?
  otpExpiresAt    DateTime?
  passwordHash    String
  firstName       String
  lastName        String
  role            Role      @default(CUSTOMER)
  isVerified      Boolean   @default(false)
  isBlocked       Boolean   @default(false)
  profileImage    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  profile         UserProfile?
  vehicles        Vehicle[] @relation("HostVehicles")
  bookings        Booking[] @relation("CustomerBookings")
  driverBookings  Booking[] @relation("DriverBookings")
  reviewsGiven    Review[]  @relation("ReviewAuthor")
  ratingsGiven    PartyRating[] @relation("PartyRatingAuthor")
  ratingsReceived PartyRating[] @relation("PartyRatingTarget")
  wallet          Wallet?
  documents       Document[]
  kycSessions     KycSession[]
  media           Media[]
  dlValidUntil    DateTime?
  payoutAccount   PayoutAccount?
  notifications   Notification[]

  @@index([phone, email])
}

model UserProfile {
  id                   String    @id @default(uuid())
  userId               String    @unique
  firstName            String
  lastName             String
  city                 String    @default("Ahmedabad")
  state                String    @default("Gujarat")
  postalCode           String?
  aadhaarNumberHash    String?   @unique
  aadhaarNumberMasked  String?
  panNumberHash        String?   @unique
  panNumberMasked      String?
  drivingLicenseHash   String?   @unique
  drivingLicenseMasked String?
  dlExpiryDate         DateTime?
  profileImageUrl      String?
  selfieMediaId        String?
  faceMatchScore       Float?
  faceMatchStatus      String?   @default("UNVERIFIED")
  isKycVerified        Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Hub {
  id              String    @id @default(uuid())
  hubName         String
  city            String
  latitude        Float
  longitude       Float
  address         String
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())

  vehicles        Vehicle[]
  pickupBookings  Booking[] @relation("PickupHubBookings")
  dropoffBookings Booking[] @relation("DropoffHubBookings")

  @@index([city, isActive])
}

model VehicleModel {
  id              String    @id @default(uuid())
  brand           String
  modelName       String
  segment         String
  transmission    String
  fuelType        String
  seatingCapacity Int
  baseHourlyRate  Decimal
  freeKmPerHour   Int       @default(12)
  createdAt       DateTime  @default(now())

  vehicles        Vehicle[]

  @@unique([brand, modelName, transmission, fuelType])
}

model Vehicle {
  id                       String        @id @default(uuid())
  hostId                   String
  modelSpecId              String?
  currentHubId             String?
  make                     String
  model                    String
  year                     Int
  category                 String        
  transmission             String
  fuelType                 String
  seats                    Int
  pricePerDay              Decimal
  extraKmCharge            Decimal       @default(12)
  includedKilometresPerDay Int           @default(300)
  securityDeposit          Decimal       @default(2000)
  status                   VehicleStatus @default(PENDING_APPROVAL)
  serviceType              String        @default("self_drive")
  locationCity             String
  pickupAddress            String?
  dropAddress              String?
  latitude                 Float?
  longitude                Float?
  images                   String      
  features                 String?
  vinNumber                String?       @unique
  gpsDeviceImei            String?       @unique
  fuelLevelPercent         Int           @default(100)
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  host               User                @relation("HostVehicles", fields: [hostId], references: [id])
  modelSpec          VehicleModel?       @relation(fields: [modelSpecId], references: [id])
  currentHub         Hub?                @relation(fields: [currentHubId], references: [id])
  bookings           Booking[]
  reviews            Review[]
  registrationNumber String?             @unique
  odometer           Int                 @default(0)
  reviewNote         String?
  media              Media[]
  documents          Document[]
  availabilityBlocks AvailabilityBlock[]

  @@index([locationCity, status])
  @@index([currentHubId, status])
}

model AvailabilityBlock {
  id String @id @default(uuid())
  vehicleId String
  startDate DateTime
  endDate DateTime
  reason String
  releasedAt DateTime?
  createdAt DateTime @default(now())
  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  @@index([vehicleId, startDate, endDate])
}

model Booking {
  id                  String        @id @default(uuid())
  bookingRef          String        @unique 
  customerId          String
  vehicleId           String
  driverId            String?
  pickupHubId         String?
  dropoffHubId        String?
  startDate           DateTime
  endDate             DateTime
  tenureHours         Int           @default(24)
  serviceType         String        @default("self_drive")
  baseFare            Decimal       @default(0)
  securityDeposit     Decimal       @default(0)
  insuranceFee        Decimal       @default(0)
  discountAmount      Decimal       @default(0)
  taxAmount           Decimal       @default(0)
  platformFee         Decimal       @default(0)
  hostRevenue         Decimal       @default(0)
  totalAmount         Decimal
  status              BookingStatus @default(PENDING)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  customer            User          @relation("CustomerBookings", fields: [customerId], references: [id])
  driver              User?         @relation("DriverBookings", fields: [driverId], references: [id])
  vehicle             Vehicle       @relation(fields: [vehicleId], references: [id])
  pickupHub           Hub?          @relation("PickupHubBookings", fields: [pickupHubId], references: [id])
  dropoffHub          Hub?          @relation("DropoffHubBookings", fields: [dropoffHubId], references: [id])
  payment             Payment?
  trip                Trip?
  expiresAt           DateTime?
  requestKey          String?       @unique
  dailyRate           Decimal       @default(0)
  rentalDays          Int           @default(1)
  includedKilometres  Int?
  agreementVersion    String        @default("safarcars-car-sharing-v2")
  agreementSnapshot   String?
  agreementAcceptedAt DateTime?
  invoice             Invoice?
  inspections         Inspection[]
  partyRatings        PartyRating[]

  @@index([customerId, status])
  @@index([vehicleId, startDate, endDate, status])
}

model Trip {
  id                   String           @id @default(uuid())
  bookingId            String           @unique
  actualStartTime      DateTime?
  actualEndTime        DateTime?
  startOdometer        Int?
  endOdometer          Int?
  startFuelLevel       Int?
  endFuelLevel         Int?
  startChecklistImages String?
  endChecklistImages   String?
  startSelfieUrl       String?
  endSelfieUrl         String?
  extraKmDriven        Int              @default(0)
  extraHours           Decimal          @default(0.0)
  penaltyCharges       Decimal          @default(0.0)
  tripStatus           String           @default("not_started")
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  booking              Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  telematics           TripTelematics[]
}

model TripTelematics {
  id         String   @id @default(uuid())
  tripId     String
  latitude   Float
  longitude  Float
  speedKmph  Decimal?
  fuelLevel  Int?
  recordedAt DateTime @default(now())

  trip       Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, recordedAt])
}

model Media {
  id String @id @default(uuid())
  ownerId String
  vehicleId String?
  kind String
  storageKey String @unique
  mimeType String
  size Int
  sha256 String
  createdAt DateTime @default(now())
  owner User @relation(fields: [ownerId], references: [id])
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id])
  @@index([ownerId, vehicleId])
}

model Document {
  id                   String    @id @default(uuid())
  userId               String
  vehicleId            String?
  kind                 String
  documentNumberMasked String?
  documentFrontUrl     String?
  documentBackUrl      String?
  mediaId              String?
  status               String    @default("PENDING")
  source               String    @default("UPLOAD")
  providerSessionId    String?
  validUntil           DateTime?
  reviewNote           String?
  verifiedById         String?
  verifiedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle              Vehicle?  @relation(fields: [vehicleId], references: [id])
  @@index([userId, kind, status])
}

model KycSession {
  id String @id @default(uuid())
  userId String
  providerId String @unique
  environment String
  status String @default("CREATED")
  consentAt DateTime @default(now())
  consentVersion String @default("rental-kyc-v1")
  expiresAt DateTime
  user User @relation(fields: [userId], references: [id])
}

model Invoice {
  id String @id @default(uuid())
  number String @unique
  bookingId String @unique
  amount Decimal
  currency String @default("INR")
  status String @default("PAID")
  snapshot String
  createdAt DateTime @default(now())
  booking Booking @relation(fields: [bookingId], references: [id])
}

model Inspection {
  id String @id @default(uuid())
  bookingId String
  stage String
  odometer Int
  mediaId String
  mediaIds String?
  selfieMediaId String?
  note String?
  fuelPercent Int?
  damageNote String?
  createdAt DateTime @default(now())
  booking Booking @relation(fields: [bookingId], references: [id])
  @@unique([bookingId, stage])
}

model AuditLog {
  id String @id @default(uuid())
  actorId String
  action String
  targetId String
  detail String
  createdAt DateTime @default(now())
}

model Payment {
  id              String   @id @default(uuid())
  bookingId       String   @unique
  transactionId   String   @unique 
  gatewayProvider String   @default("Razorpay")
  paymentType     String   @default("booking_fare")
  amount          Decimal
  currency        String   @default("INR")
  status          String   
  createdAt       DateTime @default(now())

  booking         Booking  @relation(fields: [bookingId], references: [id])
}

model Review {
  id             String   @id @default(uuid())
  authorId       String
  vehicleId      String
  rating         Int      
  comment        String?
  createdAt      DateTime @default(now())

  author         User     @relation("ReviewAuthor", fields: [authorId], references: [id])
  vehicle        Vehicle  @relation(fields: [vehicleId], references: [id])
}

model Wallet {
  id             String   @id @default(uuid())
  userId         String   @unique
  balance        Decimal       @default(0.00)
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id])
}

model PartyRating {
  id         String   @id @default(uuid())
  bookingId  String
  authorId   String
  targetId   String
  targetRole String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])
  author  User    @relation("PartyRatingAuthor", fields: [authorId], references: [id])
  target  User    @relation("PartyRatingTarget", fields: [targetId], references: [id])

  @@unique([bookingId, authorId, targetId])
  @@index([targetId, createdAt])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  bookingId String?
  metadata  String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  @@index([userId, readAt, createdAt])
}

model PayoutAccount {
  id                     String   @id @default(uuid())
  userId                 String   @unique
  accountHolderName      String
  bankName               String
  accountNumberLast4     String
  ifscCode               String
  encryptedAccountNumber String
  status                 String   @default("PENDING")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  user                   User     @relation(fields: [userId], references: [id])
  payouts                Payout[]
}

model Payout {
  id          String   @id @default(uuid())
  accountId   String
  amount      Decimal
  status      String   @default("PENDING")
  reference   String?
  periodStart DateTime?
  periodEnd   DateTime?
  note        String?
  createdAt   DateTime @default(now())
  processedAt DateTime?
  account     PayoutAccount @relation(fields: [accountId], references: [id])
  @@index([accountId, status])
}
