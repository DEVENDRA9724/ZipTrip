datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  HOST
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum VehicleStatus {
  PENDING_APPROVAL
  ACTIVE
  INACTIVE
  MAINTENANCE
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  phone         String?   @unique
  passwordHash  String
  firstName     String
  lastName      String
  role          Role      @default(CUSTOMER)
  isVerified    Boolean   @default(false)
  profileImage  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  vehicles      Vehicle[] @relation("HostVehicles")
  bookings      Booking[] @relation("CustomerBookings")
  reviewsGiven  Review[]  @relation("ReviewAuthor")
  wallet        Wallet?
  documents     Document[]
  kycSessions   KycSession[]
  media         Media[]
  dlValidUntil  DateTime?
}

model Vehicle {
  id             String        @id @default(uuid())
  hostId         String
  make           String
  model          String
  year           Int
  category       String        
  transmission   String
  fuelType       String
  seats          Int
  pricePerDay    Decimal
  status         VehicleStatus @default(PENDING_APPROVAL)
  locationCity   String
  latitude       Float?
  longitude      Float?
  images         String      
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  host           User          @relation("HostVehicles", fields: [hostId], references: [id])
  bookings       Booking[]
  reviews        Review[]
  registrationNumber String? @unique
  odometer       Int @default(0)
  reviewNote     String?
  media          Media[]
  documents      Document[]

  @@index([locationCity, status])
}

model Booking {
  id             String        @id @default(uuid())
  bookingRef     String        @unique 
  customerId     String
  vehicleId      String
  startDate      DateTime
  endDate        DateTime
  totalAmount    Decimal
  status         BookingStatus @default(PENDING)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  customer       User          @relation("CustomerBookings", fields: [customerId], references: [id])
  vehicle        Vehicle       @relation(fields: [vehicleId], references: [id])
  payment        Payment?
  expiresAt      DateTime?
  requestKey     String? @unique
  dailyRate      Decimal @default(0)
  rentalDays     Int @default(1)
  invoice        Invoice?
  inspections    Inspection[]

  @@index([vehicleId, startDate, endDate, status])
}

model Media {
  id String @id @default(uuid())
  ownerId String
  vehicleId String?
  kind String
  storageKey String @unique
  mimeType String
  size Int
  sha256 String
  createdAt DateTime @default(now())
  owner User @relation(fields: [ownerId], references: [id])
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id])
  @@index([ownerId, vehicleId])
}

model Document {
  id String @id @default(uuid())
  userId String
  vehicleId String?
  kind String
  mediaId String?
  status String @default("PENDING")
  source String @default("UPLOAD")
  providerSessionId String?
  validUntil DateTime?
  reviewNote String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id])
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id])
  @@index([userId, kind, status])
}

model KycSession {
  id String @id @default(uuid())
  userId String
  providerId String @unique
  environment String
  status String @default("CREATED")
  consentAt DateTime @default(now())
  consentVersion String @default("rental-kyc-v1")
  expiresAt DateTime
  user User @relation(fields: [userId], references: [id])
}

model Invoice {
  id String @id @default(uuid())
  number String @unique
  bookingId String @unique
  amount Decimal
  currency String @default("INR")
  status String @default("PAID")
  snapshot String
  createdAt DateTime @default(now())
  booking Booking @relation(fields: [bookingId], references: [id])
}

model Inspection {
  id String @id @default(uuid())
  bookingId String
  stage String
  odometer Int
  mediaId String
  note String?
  createdAt DateTime @default(now())
  booking Booking @relation(fields: [bookingId], references: [id])
  @@unique([bookingId, stage])
}

model AuditLog {
  id String @id @default(uuid())
  actorId String
  action String
  targetId String
  detail String
  createdAt DateTime @default(now())
}

model Payment {
  id             String   @id @default(uuid())
  bookingId      String   @unique
  transactionId  String   @unique 
  amount         Decimal
  currency       String   @default("INR")
  status         String   
  createdAt      DateTime @default(now())

  booking        Booking  @relation(fields: [bookingId], references: [id])
}

model Review {
  id             String   @id @default(uuid())
  authorId       String
  vehicleId      String
  rating         Int      
  comment        String?
  createdAt      DateTime @default(now())

  author         User     @relation("ReviewAuthor", fields: [authorId], references: [id])
  vehicle        Vehicle  @relation(fields: [vehicleId], references: [id])
}

model Wallet {
  id             String   @id @default(uuid())
  userId         String   @unique
  balance        Decimal       @default(0.00)
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id])
}
