{
  "expo": {
    "name": "Safar Self Drive",
    "slug": "safar-self-drive",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "safar",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "in.safar.selfdrive",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Safar needs camera access to capture vehicle condition photos during handover and return.",
        "NSPhotoLibraryUsageDescription": "Safar needs photo library access to upload driving license and KYC documents.",
        "NSLocationWhenInUseUsageDescription": "Safar needs your location to display nearby car pickup hubs and delivery distance."
      }
    },
    "android": {
      "package": "in.safar.selfdrive",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Safar uses your photos for vehicle and trip inspection evidence.",
          "cameraPermission": "Safar uses your camera for vehicle and trip inspection evidence."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "031b74c6-8204-4def-a724-5f60872245f1"
      }
    }
  }
}
