# ==============================================================================
# Safar Self Drive Production Environment Variables
# Copy to .env.production on your production server. NEVER commit real secrets.
# ==============================================================================

# Core Application Settings
NODE_ENV=production
PORT=3000
DOMAIN=safarselfdrive.com
ACME_EMAIL=admin@safarselfdrive.com
WEB_ORIGIN=https://safarselfdrive.com,https://www.safarselfdrive.com

# Database Connection (PostgreSQL)
POSTGRES_USER=safar_admin
POSTGRES_PASSWORD=replace_with_strong_random_db_password
POSTGRES_DB=safar_production
DATABASE_URL=postgresql://safar_admin:replace_with_strong_random_db_password@postgres:5432/safar_production?schema=public
POSTGRES_DATABASE_URL=postgresql://safar_admin:replace_with_strong_random_db_password@postgres:5432/safar_production?schema=public

# In-Memory Cache (Redis)
REDIS_PASSWORD=replace_with_strong_random_redis_password
REDIS_URL=redis://:replace_with_strong_random_redis_password@redis:6379

# Security & Encryption (Generate with: openssl rand -hex 32)
JWT_SECRET=replace_with_at_least_32_characters_random_key_64hex
DOCUMENT_ENCRYPTION_KEY=replace_with_64_character_hex_key_for_aes256
PAYOUT_ENCRYPTION_KEY=replace_with_64_character_hex_key_for_aes256

# Storage (AWS S3 for KYC, vehicle docs, and rental inspection photos)
AWS_REGION=ap-south-1
S3_BUCKET=safar-production-media
S3_PREFIX=safar-media
# Leave blank on AWS EC2/ECS with IAM role, or provide credentials:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Payment Gateway (Cashfree / Razorpay)
PAYMENT_MODE=gateway
PAYMENT_WEBHOOK_SECRET=replace_with_gateway_webhook_signing_secret

# Sandbox / Aadhaar DigiLocker Verification
SANDBOX_ENV=live
SANDBOX_API_KEY=replace_with_sandbox_api_key
SANDBOX_API_SECRET=replace_with_sandbox_api_secret
KYC_REDIRECT_URL=https://safarselfdrive.com/kyc.html

# Business Information for GST Invoices & Digital Passes
BUSINESS_NAME=Safar Self Drive
BUSINESS_LEGAL_NAME=Safar Car Rentals Private Limited
BUSINESS_GSTIN=24AAACS1234F1Z5
BUSINESS_ADDRESS=Swami Vivekanand Bridge, Ashram Road, Ahmedabad, Gujarat 380009
BUSINESS_PHONE=+91 99000 00001
BUSINESS_EMAIL=support@safarselfdrive.com
